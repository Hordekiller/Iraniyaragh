NODE_ENV=development
API_PORT=4000
ALLOW_DATABASE_SEED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
DATABASE_URL=postgresql://app:app@localhost:5432/iranyaragh
REDIS_URL=redis://localhost:6379
AUTH_JWT_ISSUER=iranyaragh-api
JWT_ACCESS_SECRET=development-only-access-secret-replace-me
AUTH_HASH_KEY_VERSION=1
AUTH_HASH_SECRET=development-only-hash-root-secret-replace-me
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=products
