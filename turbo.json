{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "test": { "dependsOn": ["^test"] },
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
