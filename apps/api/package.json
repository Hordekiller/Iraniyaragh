{
  "name": "@iranyaragh/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
    "rbac:baseline": "node prisma/apply-rbac-baseline.mjs",
    "demo:staging": "node prisma/seed-demo-staging.mjs",
    "auth:e2e-staff": "node scripts/provision-e2e-staff.mjs",
    "media:bucket": "node scripts/provision-media-bucket.mjs",
    "invoice-pdf:capacity": "node scripts/provision-invoice-pdf-capacity.mjs",
    "report-export:capacity": "node scripts/provision-report-export-capacity.mjs",
    "dev": "nest start --watch",
    "worker:media": "node dist/src/media-worker.js",
    "worker:pdf": "node dist/src/pdf-render-worker.js",
    "outbox:replay": "node scripts/replay-outbox.mjs",
    "build": "nest build --path tsconfig.build.json && node scripts/verify-runtime-artifacts.mjs",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run && node --test prisma/*.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "REGENERATE_OPENAPI=1 vitest run src/openapi.regenerate.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@iranyaragh/contracts": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "bullmq": "6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "4.4.0",
    "file-type": "21.3.4",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "otplib": "13.5.0",
    "playwright": "1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  }
}
