generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  LOCKED
  DELETED
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP
  VERIFY_MOBILE
  VERIFY_EMAIL
  PASSWORD_RESET
  CHANGE_MOBILE
  SENSITIVE_ACTION
}

enum OtpChannel {
  SMS
  EMAIL
}

enum LoginMethod {
  PASSWORD
  OTP
  REFRESH_TOKEN
  TOTP
  RECOVERY_CODE
}

enum LoginAttemptOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  INVALID_CODE
  EXPIRED_CODE
  RATE_LIMITED
  ACCOUNT_LOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCKTAKE
  RESERVATION
  RELEASE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  REVIEW
  COMPLETED
  CANCELLED
}

model User {
  id                     String                  @id @default(cuid())
  mobile                 String?                 @unique @db.VarChar(13)
  email                  String?                 @unique @db.VarChar(320)
  passwordHash           String?                 @db.Text
  firstName              String?                 @db.VarChar(100)
  lastName               String?                 @db.VarChar(100)
  status                 UserStatus              @default(PENDING)
  isMobileVerified       Boolean                 @default(false)
  mobileVerifiedAt       DateTime?
  isEmailVerified        Boolean                 @default(false)
  emailVerifiedAt        DateTime?
  passwordChangedAt      DateTime?
  failedLoginCount       Int                     @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  otpCodes               OtpCode[]
  loginAttempts          LoginAttempt[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  orderTransitions       OrderTransition[]       @relation("OrderActor")
  paymentTransitions     PaymentTransition[]     @relation("PaymentActor")
  fulfillmentTransitions FulfillmentTransition[] @relation("FulfillmentActor")
  roleAssignments        UserRole[]              @relation("UserRoleSubject")
  roleAssignmentsGranted UserRole[]              @relation("UserRoleAssigner")
  roleAssignmentsRevoked UserRole[]              @relation("UserRoleRevoker")
  permissionGrants       RolePermission[]        @relation("RolePermissionGrantor")
  permissionRevocations  RolePermission[]        @relation("RolePermissionRevoker")

  @@index([status, createdAt])
  @@index([lockedUntil])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(150)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  group       String           @db.VarChar(100)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([group, isActive])
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?   @db.VarChar(500)
  user         User      @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    User?     @relation("UserRoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId, revokedAt, expiresAt])
  @@index([roleId, revokedAt])
  @@index([assignedById])
  @@index([revokedById])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime   @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?    @db.VarChar(500)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy    User?      @relation("RolePermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy    User?      @relation("RolePermissionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([roleId, revokedAt])
  @@index([permissionId, revokedAt])
  @@index([grantedById])
  @@index([revokedById])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique @db.VarChar(255)
  tokenFamilyId       String    @db.VarChar(30)
  replacedBySessionId String?   @unique
  deviceIdHash        String?   @db.VarChar(255)
  deviceName          String?   @db.VarChar(150)
  userAgent           String?   @db.Text
  ipHash              String?   @db.VarChar(255)
  lastUsedAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokeReason        String?   @db.VarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          Session?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            Session?  @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId, createdAt])
  @@index([expiresAt])
}

model OtpCode {
  id              String     @id @default(cuid())
  userId          String?
  destinationHash String     @db.VarChar(255)
  codeHash        String     @db.VarChar(255)
  purpose         OtpPurpose
  channel         OtpChannel
  attempts        Int        @default(0)
  maxAttempts     Int        @default(5)
  expiresAt       DateTime
  consumedAt      DateTime?
  invalidatedAt   DateTime?
  requestedIpHash String?    @db.VarChar(255)
  requestId       String?    @db.VarChar(100)
  createdAt       DateTime   @default(now())
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationHash, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt, consumedAt, invalidatedAt])
  @@index([requestedIpHash, createdAt])
}

model LoginAttempt {
  id             String              @id @default(cuid())
  userId         String?
  identifierHash String?             @db.VarChar(255)
  ipHash         String?             @db.VarChar(255)
  method         LoginMethod
  outcome        LoginAttemptOutcome
  requestId      String?             @db.VarChar(100)
  userAgent      String?             @db.Text
  createdAt      DateTime            @default(now())
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
  @@index([outcome, createdAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  status      ProductStatus    @default(DRAFT)
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String              @unique
  barcode        String?             @unique
  title          String?
  costPrice      BigInt
  salePrice      BigInt
  weightGrams    Int?
  isActive       Boolean             @default(true)
  inventory      InventoryBalance[]
  movements      InventoryMovement[]
  reservations   StockReservation[]
  orderItems     OrderItem[]
  transferItems  StockTransferItem[]
  purchaseItems  PurchaseOrderItem[]
  stocktakeItems StocktakeItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([productId])
}

model Warehouse {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  city            String?
  address         String?
  isActive        Boolean             @default(true)
  balances        InventoryBalance[]
  movements       InventoryMovement[]
  reservations    StockReservation[]
  sourceTransfers StockTransfer[]     @relation("TransferSource")
  targetTransfers StockTransfer[]     @relation("TransferTarget")
  locations       WarehouseLocation[]
  purchaseOrders  PurchaseOrder[]
  stocktakes      Stocktake[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model InventoryBalance {
  id          String            @id @default(cuid())
  warehouseId String
  locationId  String
  variantId   String
  onHand      Int               @default(0)
  reserved    Int               @default(0)
  available   Int               @default(0)
  version     Int               @default(0)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt   DateTime          @updatedAt

  @@unique([warehouseId, locationId, variantId])
  @@index([warehouseId, variantId])
  @@index([variantId, available])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  warehouseId    String
  locationId     String
  variantId      String
  type           InventoryMovementType
  quantity       Int
  beforeOnHand   Int
  afterOnHand    Int
  referenceType  String?
  referenceId    String?
  reason         String?
  idempotencyKey String?               @unique
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  location       WarehouseLocation     @relation(fields: [locationId], references: [id])
  variant        ProductVariant        @relation(fields: [variantId], references: [id])
  createdAt      DateTime              @default(now())

  @@index([warehouseId, variantId, createdAt])
  @@index([referenceType, referenceId])
}

model StockReservation {
  id          String            @id @default(cuid())
  warehouseId String
  locationId  String
  variantId   String
  orderId     String?
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  location    WarehouseLocation @relation(fields: [locationId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([warehouseId, variantId, status, expiresAt])
}

model StockTransfer {
  id                String              @id @default(cuid())
  code              String              @unique
  sourceWarehouseId String
  targetWarehouseId String
  status            TransferStatus      @default(DRAFT)
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse           @relation("TransferTarget", fields: [targetWarehouseId], references: [id])
  items             StockTransferItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model StockTransferItem {
  id         String         @id @default(cuid())
  transferId String
  variantId  String
  quantity   Int
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

model WarehouseLocation {
  id           String              @id @default(cuid())
  warehouseId  String
  code         String
  name         String?
  zone         String?
  aisle        String?
  rack         String?
  shelf        String?
  bin          String?
  isActive     Boolean             @default(true)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  movements    InventoryMovement[]
  reservations StockReservation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([warehouseId, code])
}

model Supplier {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  mobile         String?
  phone          String?
  email          String?
  nationalId     String?
  economicCode   String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId, createdAt])
  @@index([warehouseId, status])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  variantId       String
  orderedQty      Int
  receivedQty     Int            @default(0)
  unitCost        BigInt
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([purchaseOrderId, variantId])
}

model Stocktake {
  id          String          @id @default(cuid())
  number      String          @unique
  warehouseId String
  status      StocktakeStatus @default(DRAFT)
  notes       String?
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  items       StocktakeItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([warehouseId, status])
}

model StocktakeItem {
  id          String         @id @default(cuid())
  stocktakeId String
  variantId   String
  expectedQty Int
  countedQty  Int?
  difference  Int?
  stocktake   Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([stocktakeId, variantId])
}

model Customer {
  id        String   @id @default(cuid())
  mobile    String   @unique
  firstName String?
  lastName  String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           String             @id @default(cuid())
  number       String             @unique
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id])
  status       OrderStatus        @default(PENDING_PAYMENT)
  subtotal     BigInt
  discount     BigInt            @default(0)
  shipping     BigInt            @default(0)
  grandTotal   BigInt
  items        OrderItem[]
  payments     Payment[]
  reservations StockReservation[]
  fulfillment  Fulfillment?
  transitions  OrderTransition[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  sku       String
  title     String
  quantity  Int
  unitPrice BigInt
  total     BigInt
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id             String              @id @default(cuid())
  orderId        String
  provider       String
  amount         BigInt
  status         PaymentStatus       @default(PENDING)
  authority      String?
  referenceId    String?
  idempotencyKey String              @unique
  order          Order               @relation(fields: [orderId], references: [id])
  transitions    PaymentTransition[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orderId, status])
}

model OrderTransition {
  id        String      @id @default(cuid())
  orderId   String
  from      OrderStatus
  to        OrderStatus
  reason    String?     @db.VarChar(255)
  actorId   String?
  actor     User?       @relation("OrderActor", fields: [actorId], references: [id], onDelete: SetNull)
  requestId String?     @db.VarChar(100)
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, requestId])
  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([to, createdAt])
}

model PaymentTransition {
  id        String        @id @default(cuid())
  paymentId String
  from      PaymentStatus
  to        PaymentStatus
  reason    String?       @db.VarChar(255)
  actorId   String?
  actor     User?         @relation("PaymentActor", fields: [actorId], references: [id], onDelete: SetNull)
  requestId String?       @db.VarChar(100)
  createdAt DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, requestId])
  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
  @@index([to, createdAt])
}

model Fulfillment {
  id        String            @id @default(cuid())
  orderId   String            @unique
  status    FulfillmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order       Order                   @relation(fields: [orderId], references: [id])
  transitions FulfillmentTransition[]

  @@index([status, updatedAt])
}

model FulfillmentTransition {
  id            String            @id @default(cuid())
  fulfillmentId String
  from          FulfillmentStatus
  to            FulfillmentStatus
  reason        String?           @db.VarChar(255)
  actorId       String?
  actor         User?             @relation("FulfillmentActor", fields: [actorId], references: [id], onDelete: SetNull)
  requestId     String?           @db.VarChar(100)
  createdAt     DateTime          @default(now())

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)

  @@unique([fulfillmentId, requestId])
  @@index([fulfillmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([to, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(150)
  entityType String   @db.VarChar(150)
  entityId   String?  @db.VarChar(100)
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?  @db.VarChar(100)
  ipHash     String?  @db.VarChar(255)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
