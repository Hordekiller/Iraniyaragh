{
  "name": "@iranyaragh/e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright smoke suite for the storefront (web) and admin shells",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test",
    "test:headed": "playwright test --headed",
    "test:install": "playwright install chromium",
    "test:report": "playwright show-report",
    "screenshots": "node scripts/capture-auth-screenshots.mjs",
    "screenshots:admin-sessions": "node scripts/capture-admin-sessions-screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "otplib": "13.5.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
