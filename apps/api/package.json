    "@types/node": "^24.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^6.15.0",
