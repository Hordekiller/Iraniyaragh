# Staging deployment environment template.
#
# Copy to `.env.staging` on the host, fill in real values, and keep the copy
# untracked. `.gitignore` already excludes `.env.*`, so the filled file cannot be
# committed by accident. Never commit real values into this example.
#
# The API validates this file at boot and refuses to start in staging or
# production when a value is missing, a secret is shorter than 32 characters or
# still a placeholder, a public origin is not https, the payment gateway is not
# live, or SMS credentials are absent. That validation is the reason this
# template is explicit: an incomplete file produces a failed deploy, not a
# half-configured storefront.

# --- identity ----------------------------------------------------------------

# Exact commit SHA of the release to run, e.g. 40 hex characters. Images are
# built by CI and tagged with this SHA; the host pulls them and never builds.
#
# Leave it unset here. compose.staging.yml refuses to resolve without it, so a
# host that was never given an explicit release fails loudly instead of silently
# running whatever `latest` last pointed at. deploy.sh fills it in from the
# checked-out commit and rewrites it after a successful deploy to record the
# rollback target.
#
# IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
#
# Registry the images are pulled from. Only change this to test against a
# different registry; the default is this repository's own GHCR namespace.
# IMAGE_REGISTRY=ghcr.io/hordekiller

# Which environment the API-side services report as. `staging` is what allows
# the explicitly disabled payment and SMS providers below. Do not set this to
# `production` on a staging host: production rejects the disabled modes and
# demands real provider credentials.
# APP_ENVIRONMENT=staging

COMPOSE_PROJECT_NAME=iranyaragh

# --- public entry points -----------------------------------------------------

# Host ports Nginx binds. 80 serves the ACME challenge and redirects everything
# else to HTTPS, so it has to stay published even though it serves no content.
# Override these only when something else already owns the port on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Where the TLS certificate and the ACME challenge directory live on the host, and
# where they are bind-mounted inside the web container. The web container
# terminates TLS itself, so these are read by Nginx at startup: a missing
# certificate is a startup failure, not a degraded mode, which is why
# scripts/deploy/ensure-certificate.sh has to run before the first `up`.
TLS_DIR=/srv/iranyaragh/tls
ACME_WEBROOT_DIR=/srv/iranyaragh/acme-webroot

# Public origin of the storefront. Must be https in staging/production: the API
# rejects http here, which is how it was confirmed -- `docker run` on the built
# image refuses to boot with an http value. This is the origin customers use, so
# set it to the real public address, not localhost.
#
# There is no domain name yet, so this is the host's public IP. It is still a real
# https origin rather than a placeholder: Nginx terminates TLS here with a Let's
# Encrypt IP address certificate, so https://185.211.59.93 is genuinely served and
# a browser validates it against a public CA. Replace the origins with the domain
# once there is one.
STOREFRONT_ORIGIN=https://185.211.59.93

# Comma-separated browser origins allowed to call the API. The API requires at
# least one and refuses to start without it, so it is not optional even though
# the storefront and the Admin share the public origin: the storefront calls the
# API cross-origin unless VITE_API_BASE_URL points at the same host, and the
# Admin is served from a subpath. Add any further real origins, comma separated.
CORS_ORIGINS=https://185.211.59.93

# Proxies in front of the API, so it can derive the real client IP from
# X-Forwarded-For without trusting a header anyone could send directly. The
# staging compose sets this to 1, because the Nginx container is the only hop in
# front of the API. A bare integer means a hop count (1-5); a comma-separated
# list of IPs/CIDRs restricts trust to those networks instead. Nothing else may
# reach the API directly, or leave this empty and every request looks like it
# came from the proxy.
TRUST_PROXY=1

# Where the browser reaches the API. Same public origin as the storefront,
# because Nginx proxies /api on the storefront host.
VITE_API_BASE_URL=https://185.211.59.93/api/v1
NEXT_PUBLIC_API_BASE_URL=https://185.211.59.93/api/v1

# Subpath the Admin is mounted on. The Nginx vhost proxies /admin, and Next only
# emits correct asset URLs when the build knows the same prefix, so this must
# match the proxy. Compose defaults it to /admin; set it here to make the
# coupling explicit, or to a different value if the Admin moves.
NEXT_PUBLIC_BASE_PATH=/admin

# Browser-visible origin of published product media. Must be https.
# Nginx serves the object store under /media, so the browser-facing base is the
# storefront origin plus that prefix.
#
# The trailing /products must match OBJECT_STORAGE_BUCKET above. Object keys
# stored in the bucket carry no bucket name, but the store is addressed
# path-style, so the bucket has to be part of the public path. Local development
# uses localhost:9000/products for the same reason. Changing one without the
# other serves 404s for every product image.
PUBLIC_MEDIA_ORIGIN=https://185.211.59.93/media/products
NEXT_PUBLIC_MEDIA_ORIGIN=https://185.211.59.93/media/products

# --- unconfirmed business data -----------------------------------------------
#
# These are NOT confirmed by the business owner. Leave them empty to publish no
# contact details at all; the storefront renders "contact information is not
# published yet" rather than a placeholder. Fill them in only from values the
# owner has verified, and do not invent them to make a deploy look complete.
VITE_SITE_PHONE=
VITE_SITE_POSTAL_CODE=
VITE_SITE_ADDRESS=
VITE_SITE_EMAIL=
VITE_INSTAGRAM_HANDLE=

# --- database ----------------------------------------------------------------

POSTGRES_DB=iranyaragh
POSTGRES_USER=iranyaragh

# Password for the database role. Must be at least 32 characters and must not be
# a placeholder, or the API refuses to boot.
POSTGRES_PASSWORD=

# The API and the migration job reach Postgres over the internal network, so this
# URL uses the Compose service name rather than a host address.
# DATABASE_URL is deliberately absent. compose.staging.yml assembles it from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, so the connection string
# cannot disagree with the role Postgres was initialised with. Setting it here
# as well reintroduced exactly that: a hand-edited copy silently kept a stale
# password and every service failed to authenticate.

# --- cache -------------------------------------------------------------------

# At least 32 characters. Not a placeholder.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# --- authentication secrets --------------------------------------------------
#
# Each must be at least 32 characters and must not contain a placeholder string.
# Generate with: openssl rand -base64 48
#
# The first administrator is NOT created by this deploy. Run
# `pnpm --filter @iranyaragh/api auth:bootstrap -- --confirm` from a TTY on the
# host; the script refuses to run non-interactively, by design.

# Root for staff password hashing (AUTH_HASH_KEY_VERSION below selects it).
AUTH_HASH_SECRET=
AUTH_HASH_KEY_VERSION=1

# Signs access tokens.
JWT_ACCESS_SECRET=
AUTH_JWT_ISSUER=iranyaragh-api

# Encrypts stored TOTP secrets. Must be at least 32 bytes. Generate a fresh
# base64 secret; losing it locks every staff TOTP enrollment and requires
# re-enrollment, so back it up with the database.
AUTH_TOTP_ENCRYPTION_KEY=

# --- payment gateway ---------------------------------------------------------
#
# The API refuses to run in staging or production unless the gateway is live
# with a merchant id and an https callback, or explicitly disabled. There is no
# "pretend it works" mode in staging: a deploy must not be able to fabricate a
# successful payment. Zarinpal's own sandbox cannot be used here, because the API
# deliberately refuses a non-live mode outside development/test.
#
# `disabled` is a fail-closed mode for staging a deployment before a gateway
# account exists. With it, payment initiation and callback verification both
# return 503 PAYMENT_PROVIDER_DISABLED, the provider makes no network call, and
# it cannot produce an authority or a reference id, so no order can be reported
# as paid. It is refused in production. Switch to `live` once real Zarinpal
# credentials exist, and re-run the payment acceptance before taking orders.

PAYMENT_PROVIDER_MODE=disabled
ZARINPAL_MERCHANT_ID=
# Must be an https URL on a host the API can reach back. Only checked when the
# payment gateway is live, which it is not here, but it is still set to the real
# origin so that switching PAYMENT_PROVIDER_MODE to a live one cannot quietly
# leave the gateway calling back to a domain that does not exist.
ZARINPAL_CALLBACK_URL=https://185.211.59.93/api/v1/payments/callback

# --- SMS (SMS.ir) ------------------------------------------------------------
#
# All four template ids are required in staging and production whenever SMS is
# enabled. The API refuses to boot without them rather than silently skipping
# customer notifications.
#
# `disabled` is the fail-closed counterpart to the payment mode above, for
# staging before an SMS.ir account exists. Customer OTP requests then return
# 503 SMS_PROVIDER_DISABLED instead of sending anything, so no login can be
# completed by SMS and no delivery can be recorded that did not happen. It is
# refused in production. Switch to `smsir` once credentials and templates exist,
# and complete OTP acceptance before relying on customer sign-in.

SMS_PROVIDER_MODE=disabled
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=
SMS_IR_ORDER_PAID_TEMPLATE_ID=
SMS_IR_SHIPMENT_DISPATCHED_TEMPLATE_ID=
SMS_IR_SHIPMENT_DELIVERED_TEMPLATE_ID=

# --- object storage ----------------------------------------------------------
#
# S3-compatible store. These variable names are generic and provider-neutral on
# purpose: the API reaches whatever is at this endpoint through the standard S3
# API and must not learn anything about the specific server. The server-side
# compose service maps its own credentials from these same two secrets.
#
# Path-style addressing is required and is not optional: the store serves
# `/{bucket}/{key}` because the host has no wildcard DNS/TLS for
# `bucket.<domain>`. PUBLIC_MEDIA_ORIGIN below must carry the same bucket.

OBJECT_STORAGE_ENDPOINT=http://object-store:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=products
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- product media limits ----------------------------------------------------
#
# These have no defaults in staging/production on purpose: an operator must
# choose limits that fit the host rather than inheriting a dev default.

# The API refuses to boot in staging or production when IMAGE_MAX_BYTES or
# MAX_IMAGE_PIXELS is blank, so these are pre-filled with the API's own defaults
# rather than left empty. They are the same numbers the API would use anyway; set
# them explicitly so a fresh copy of this template boots.
PRODUCT_MEDIA_MAX_ASSETS=12
PRODUCT_MEDIA_MAX_VIDEOS=3
# Note the name: the API reads PRODUCT_MEDIA_IMAGE_MAX_BYTES. A previous version
# of this template had PRODUCT_MEDIA_MAX_IMAGE_BYTES, which the API silently
# ignored and then refused to boot for, since it has no default in
# staging/production.
PRODUCT_MEDIA_IMAGE_MAX_BYTES=20971520
PRODUCT_MEDIA_MAX_IMAGE_PIXELS=40000000
PRODUCT_MEDIA_UPLOAD_TTL_SECONDS=900
PRODUCT_MEDIA_WORKER_CONCURRENCY=2

# --- browser-facing build flags that must stay off ----------------------------
#
# Listed here as documentation of the negative requirement. Setting either of
# these fails the image build rather than shipping a fixture-backed UI, so there
# is no supported way to enable them in this deployment.
#   VITE_FIXTURE_CATALOG   hand-authored products instead of the real catalog
#   VITE_FIXTURE_AUTH      fake customer sign-in
#   NEXT_PUBLIC_FIXTURE_AUTH  fake staff operator
