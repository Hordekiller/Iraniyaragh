# Example fixture opt-ins for the storefront (docs/AUTH_CONTRACT.md §17/§18;
# docs/AGENT_WORKSTREAMS.md — User UI lane).
#
# Copy to `.env.development` for local dev, or commit a `.env.fixture-e2e` for
# the Playwright build. NEVER set these in a real production deployment:
# production must use the real HTTP clients (no fixture).
# VITE_API_BASE_URL=http://localhost:3000
# VITE_FIXTURE_AUTH=true
# VITE_FIXTURE_CATALOG=true
