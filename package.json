{
  "name": "iranyaragh-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck",
    "e2e": "pnpm --filter @iranyaragh/web build --mode fixture-e2e && pnpm --filter @iranyaragh/admin build && pnpm --filter @iranyaragh/e2e smoke",
    "e2e:install": "pnpm --filter @iranyaragh/e2e exec playwright install chromium",
    "format": "prettier --write .",
    "knip": "knip --include dependencies,unlisted,unresolved,files"
  },
  "devDependencies": {
    "knip": "^5.88.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3"
  }
}
