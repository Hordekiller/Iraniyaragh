generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  LOCKED
  DELETED
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP
  VERIFY_MOBILE
  VERIFY_EMAIL
  PASSWORD_RESET
  CHANGE_MOBILE
  SENSITIVE_ACTION
}

enum OtpChannel {
  SMS
  EMAIL
}

enum LoginMethod {
  PASSWORD
  OTP
  REFRESH_TOKEN
  TOTP
  RECOVERY_CODE
}

enum LoginAttemptOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  INVALID_CODE
  EXPIRED_CODE
  RATE_LIMITED
  ACCOUNT_LOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PriceType {
  BASE
  SALE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  RETURNED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCKTAKE
  RESERVATION
  RELEASE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  REVIEW
  COMPLETED
  CANCELLED
}

model User {
  id                     String           @id @default(cuid())
  mobile                 String?          @unique @db.VarChar(13)
  email                  String?          @unique @db.VarChar(320)
  passwordHash           String?          @db.Text
  firstName              String?          @db.VarChar(100)
  lastName               String?          @db.VarChar(100)
  status                 UserStatus       @default(PENDING)
  isMobileVerified       Boolean          @default(false)
  mobileVerifiedAt       DateTime?
  isEmailVerified        Boolean          @default(false)
  emailVerifiedAt        DateTime?
  passwordChangedAt      DateTime?
  failedLoginCount       Int              @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  sessions               Session[]
  otpCodes               OtpCode[]
  loginAttempts          LoginAttempt[]
  auditLogs              AuditLog[]       @relation("AuditActor")
  roleAssignments        UserRole[]       @relation("UserRoleSubject")
  rolesAssigned          UserRole[]       @relation("UserRoleAssignedBy")
  rolesRevoked           UserRole[]       @relation("UserRoleRevokedBy")
  rolePermissionsGranted RolePermission[] @relation("RolePermissionGrantedBy")
  carts                  Cart[]
  stockAlerts            StockAlertSubscription[]
  orders                 Order[]

  @@index([status, createdAt])
  @@index([lockedUntil])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(150)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  group       String           @db.VarChar(100)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([group, isActive])
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  revokedById  String?
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(500)
  user         User      @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    User?     @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId, revokedAt, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([assignedById, assignedAt])
  @@index([revokedById, revokedAt])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy    User?      @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([permissionId, roleId])
  @@index([grantedById, grantedAt])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique @db.VarChar(255)
  tokenFamilyId       String    @db.VarChar(30)
  replacedBySessionId String?   @unique
  deviceId            String?   @db.VarChar(255)
  userAgent           String?   @db.Text
  createdIpHash       String?   @db.VarChar(128)
  lastIpHash          String?   @db.VarChar(128)
  lastUsedAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokeReason        String?   @db.VarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          Session?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            Session?  @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@index([deviceId, userId])
}

model OtpCode {
  id              String     @id @default(cuid())
  userId          String?
  destinationHash String     @db.VarChar(128)
  codeHash        String     @db.VarChar(255)
  purpose         OtpPurpose
  channel         OtpChannel @default(SMS)
  attempts        Int        @default(0)
  maxAttempts     Int        @default(5)
  expiresAt       DateTime
  consumedAt      DateTime?
  invalidatedAt   DateTime?
  requestedIpHash String?    @db.VarChar(128)
  requestId       String?    @db.VarChar(100)
  createdAt       DateTime   @default(now())
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationHash, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([purpose, expiresAt, consumedAt, invalidatedAt])
  @@index([requestedIpHash, createdAt])
}

model LoginAttempt {
  id             String              @id @default(cuid())
  userId         String?
  identifierHash String?             @db.VarChar(128)
  ipHash         String?             @db.VarChar(128)
  method         LoginMethod
  outcome        LoginAttemptOutcome
  requestId      String?             @db.VarChar(100)
  userAgent      String?             @db.Text
  createdAt      DateTime            @default(now())
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([identifierHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([outcome, createdAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  brandId     String?
  brand       Brand?        @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  skus        Sku[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, categoryId])
  @@index([slug])
}

model Sku {
  id             String                  @id @default(cuid())
  productId      String
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                  @unique @db.VarChar(100)
  barcode        String?                 @unique
  title          String?
  weightGrams    Int?
  isActive       Boolean                 @default(true)
  archivedAt     DateTime?
  prices         Price[]
  inventory      InventoryBalance[]
  movements      InventoryMovement[]
  reservations   StockReservation[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  stockAlerts    StockAlertSubscription[]
  transferItems  StockTransferItem[]
  purchaseItems  PurchaseOrderItem[]
  stocktakeItems StocktakeItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([productId])
  @@index([isActive])
}

model Price {
  id            String     @id @default(cuid())
  skuId         String
  type          PriceType  @default(BASE)
  amount        BigInt
  currency      String     @default("IRR") @db.VarChar(3)
  minQuantity   Int        @default(1)
  effectiveFrom DateTime   @default(now())
  effectiveTo   DateTime?
  isActive      Boolean    @default(true)
  sku           Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([skuId, type, effectiveFrom])
  @@index([skuId, type, isActive])
  @@index([skuId, effectiveFrom, effectiveTo])
}

model Cart {
  id         String      @id @default(cuid())
  userId     String?
  guestToken String?     @db.VarChar(160)
  items      CartItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@unique([guestToken])
  @@index([userId, updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  skuId     String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, skuId])
  @@index([skuId])
}

model StockAlertSubscription {
  id         String    @id @default(cuid())
  userId     String?
  guestToken String?   @db.VarChar(160)
  skuId      String
  channel    OtpChannel @default(SMS)
  status     AlertStatus @default(ACTIVE)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sku        Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, userId])
  @@unique([skuId, guestToken])
  @@index([skuId, status])
  @@index([userId, status])
}

enum AlertStatus {
  ACTIVE
  NOTIFIED
  CANCELLED
}

model Warehouse {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  city            String?
  address         String?
  isActive        Boolean             @default(true)
  balances        InventoryBalance[]
  movements       InventoryMovement[]
  reservations    StockReservation[]
  sourceTransfers StockTransfer[]     @relation("TransferSource")
  targetTransfers StockTransfer[]     @relation("TransferTarget")
  locations       WarehouseLocation[]
  purchaseOrders  PurchaseOrder[]
  stocktakes      Stocktake[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model InventoryBalance {
  id          String            @id @default(cuid())
  warehouseId String
  locationId  String
  skuId       String
  onHand      Int               @default(0)
  reserved    Int               @default(0)
  available   Int               @default(0)
  version     Int               @default(0)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sku         Sku               @relation(fields: [skuId], references: [id], onDelete: Cascade)
  updatedAt   DateTime          @updatedAt

  @@unique([warehouseId, locationId, skuId])
  @@index([warehouseId, skuId])
  @@index([skuId, available])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  warehouseId    String
  locationId     String
  skuId          String
  type           InventoryMovementType
  quantity       Int
  beforeOnHand   Int
  afterOnHand    Int
  referenceType  String?
  referenceId    String?
  reason         String?
  idempotencyKey String?               @unique
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  location       WarehouseLocation     @relation(fields: [locationId], references: [id])
  sku            Sku                   @relation(fields: [skuId], references: [id])
  createdAt      DateTime              @default(now())

  @@index([warehouseId, skuId, createdAt])
  @@index([referenceType, referenceId])
}

model StockReservation {
  id          String            @id @default(cuid())
  warehouseId String
  locationId  String
  skuId       String
  orderId     String?
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  location    WarehouseLocation @relation(fields: [locationId], references: [id])
  sku         Sku               @relation(fields: [skuId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([warehouseId, skuId, status, expiresAt])
  @@index([skuId, status])
  @@index([orderId])
}

model StockTransfer {
  id                String              @id @default(cuid())
  code              String              @unique
  sourceWarehouseId String
  targetWarehouseId String
  status            TransferStatus      @default(DRAFT)
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse           @relation("TransferTarget", fields: [targetWarehouseId], references: [id])
  items             StockTransferItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model StockTransferItem {
  id         String         @id @default(cuid())
  transferId String
  skuId      String
  quantity   Int
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku        Sku            @relation(fields: [skuId], references: [id])

  @@index([transferId])
  @@index([skuId])
}

model WarehouseLocation {
  id           String              @id @default(cuid())
  warehouseId  String
  code         String
  name         String?
  zone         String?
  aisle        String?
  rack         String?
  shelf        String?
  bin          String?
  isActive     Boolean             @default(true)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  movements    InventoryMovement[]
  reservations StockReservation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([warehouseId, code])
}

model Supplier {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  mobile         String?
  phone          String?
  email          String?
  nationalId     String?
  economicCode   String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId, createdAt])
  @@index([warehouseId, status])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  skuId           String
  orderedQty      Int
  receivedQty     Int            @default(0)
  unitCost        BigInt
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku             Sku            @relation(fields: [skuId], references: [id])

  @@unique([purchaseOrderId, skuId])
}

model Stocktake {
  id          String          @id @default(cuid())
  number      String          @unique
  warehouseId String
  status      StocktakeStatus @default(DRAFT)
  notes       String?
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  items       StocktakeItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([warehouseId, status])
}

model StocktakeItem {
  id          String         @id @default(cuid())
  stocktakeId String
  skuId       String
  expectedQty Int
  countedQty  Int?
  difference  Int?
  stocktake   Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  sku         Sku            @relation(fields: [skuId], references: [id])

  @@unique([stocktakeId, skuId])
}

model Customer {
  id        String   @id @default(cuid())
  mobile    String   @unique
  firstName String?
  lastName  String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String            @id @default(cuid())
  number           String            @unique
  customerId       String
  userId           String?
  status           OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  subtotal         BigInt
  discount         BigInt            @default(0)
  shipping         BigInt            @default(0)
  grandTotal       BigInt
  idempotencyKey   String?           @unique
  customer         Customer          @relation(fields: [customerId], references: [id])
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  reservations     StockReservation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  skuId     String
  sku       String
  title     String
  quantity  Int
  unitPrice BigInt
  total     BigInt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuRef    Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([skuId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String
  amount         BigInt
  status         PaymentStatus @default(PENDING)
  authority      String?
  referenceId    String?
  idempotencyKey String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId, status])
  @@index([idempotencyKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(150)
  entityType String   @db.VarChar(150)
  entityId   String?  @db.VarChar(100)
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?  @db.VarChar(100)
  ipHash     String?  @db.VarChar(128)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
